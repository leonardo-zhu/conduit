# 复制为 R4S 上的 /opt/stacks/conduit/.env（权限 600），不要提交到仓库。
# 上游密钥不放这里，在后台的“上游”里配置（用下面的主密钥加密后存库）。
# 值里不能有 $：docker compose 会把 $xxx 当变量展开。

# 管理员账号。密码哈希在 web/ 目录下用 node scripts/hash-password.mjs 生成（密码至少 12 位）
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:...

# 会话签名密钥，openssl rand -base64 32。更换后所有登录会话失效
SESSION_SECRET=change-me

# 上游密钥的加密主密钥，openssl rand -base64 32。丢了或换了，所有上游密钥都要在后台重填
CONDUIT_MASTER_KEY=change-me

# 后台的访问地址，Passkey 绑定它的域名
PASSKEY_ORIGIN=https://conduit.r4s.leonardo-zhu.me

# 新的网关事件推送到 Telegram：默认用 compose 从 /opt/stacks/.secrets/global.env 加载的
# TELEGRAM_BOT_TOKEN_DEFAULT 和 TELEGRAM_CHAT_ID（OpenClaw 默认机器人），这里不用填。
# 要换成别的机器人时再填下面两项，说明见 web/.env.example
# CONDUIT_TELEGRAM_BOT_TOKEN=
# CONDUIT_TELEGRAM_CHAT_ID=
