# 复制为同目录下的 .env（权限 600），不要提交到仓库。
# 上游 Key（Ark / MiniMax / Nous）不放这里，在 NewAPI 后台的「渠道」里配置。

# 登录会话签名密钥，生成：openssl rand -hex 32
SESSION_SECRET=change-me

# 加密密钥，不设则沿用 SESSION_SECRET。设了以后不要再改，否则已加密的数据无法解密。
CRYPTO_SECRET=change-me

# —— 以下只在本地调试时需要 ——
# 数据目录，R4S 上默认 /opt/conduit
# CONDUIT_DATA_DIR=./.data
# 本地用 http 访问后台时关掉 Secure Cookie
# SESSION_COOKIE_SECURE=false
# CONDUIT_URL=http://127.0.0.1:3010
